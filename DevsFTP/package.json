{
  "name": "devsftp",
  "version": "1.0.0",
  "description": "DevsFTP — An FTP/SFTP client that works with you, not against you.",
  "main": "src/main/main.js",
  "author": "DevsFTP Support <support@devsftp.com>",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/**/*.test.js",
    "build:win": "node scripts/build_win.js",
    "build:linux": "node scripts/build_linux.js",
    "build:all": "node scripts/build_win.js && node scripts/build_linux.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@electron/asar": "^3.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "basic-ftp": "^5.0.5",
    "chokidar": "^3.6.0",
    "socks": "^2.8.9",
    "ssh2": "^1.16.0",
    "webdav": "^5.7.0"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.devsftp.app",
    "productName": "DevsFTP",
    "copyright": "Copyright © 2026 DevsFTP.com",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevsFTP"
    },
    "linux": {
      "icon": "assets/branding/icon_512.png",
      "category": "Network",
      "synopsis": "DevsFTP — SFTP & FTP Client for Linux",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "deb": {
      "packageCategory": "net",
      "priority": "optional",
      "maintainer": "DevsFTP Support <support@devsftp.com>",
      "depends": [
        "libfuse2t64 | libfuse2",
        "libnotify4",
        "libnss3"
      ]
    }
  }
}
